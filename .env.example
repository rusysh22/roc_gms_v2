DATABASE_URL=postgres://roc_gms:roc_gms_password@localhost:15432/roc_gms
PAYLOAD_SECRET=replace-with-a-long-random-secret
# Public origin of the deployed site. NEXT_PUBLIC_SITE_URL / PAYLOAD_PUBLIC_SERVER_URL are the ones
# actually read at runtime (canonical + OpenGraph/share URLs in src/lib/shareMetadata.ts); keep all
# three in sync. NEXT_PUBLIC_* are inlined at build time, so a change needs a rebuild.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_ADMIN_AUTOLOGIN=false
SEED_ADMIN_EMAIL=admin@intourney.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# "Sign in with Google" (optional - the Google button is hidden/disabled until both are set).
# Create an OAuth 2.0 Client (type: Web application) at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXT_PUBLIC_SERVER_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Analytics 4 - visitor counting on the public site (optional; analytics is not loaded
# until this is set, and only loads in production builds). Measurement ID format: G-XXXXXXXXXX,
# from GA Admin > Data Streams > your web stream. NEXT_PUBLIC_* is inlined at build time.
NEXT_PUBLIC_GA_ID=
