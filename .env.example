DATABASE_URL=postgres://roc_gms:roc_gms_password@localhost:15432/roc_gms
PAYLOAD_SECRET=replace-with-a-long-random-secret
# Public origin of the deployed site. NEXT_PUBLIC_SITE_URL / PAYLOAD_PUBLIC_SERVER_URL are the ones
# actually read at runtime (canonical + OpenGraph/share URLs in src/lib/shareMetadata.ts); keep all
# three in sync. NEXT_PUBLIC_* are inlined at build time, so a change needs a rebuild.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_ADMIN_AUTOLOGIN=false
SEED_ADMIN_EMAIL=admin@intourney.local
SEED_ADMIN_PASSWORD=ChangeMe123!
