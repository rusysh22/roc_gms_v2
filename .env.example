DATABASE_URL=postgres://roc_gms:roc_gms_password@localhost:15432/roc_gms
PAYLOAD_SECRET=replace-with-a-long-random-secret
# Public origin of the deployed site. NEXT_PUBLIC_SITE_URL / PAYLOAD_PUBLIC_SERVER_URL are the ones
# actually read at runtime (canonical + OpenGraph/share URLs in src/lib/shareMetadata.ts); keep all
# three in sync. NEXT_PUBLIC_* are inlined at build time, so a change needs a rebuild.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_ADMIN_AUTOLOGIN=false
SEED_ADMIN_EMAIL=admin@intourney.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# "Sign in with Google" (optional - the Google button is hidden/disabled until both are set).
# Create an OAuth 2.0 Client (type: Web application) at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXT_PUBLIC_SERVER_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Analytics 4 - visitor counting on the public site (optional; analytics is not loaded
# until this is set, and only loads in production builds). Measurement ID format: G-XXXXXXXXXX,
# from GA Admin > Data Streams > your web stream. NEXT_PUBLIC_* is inlined at build time.
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile secret for Quick Bracket Tournament's guest creation form (optional - the
# bot check silently no-ops, allowing all submissions, until this is set - see
# src/lib/quickBracketTurnstile.ts). Get one at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# Berlanggan (berlanggan.web.id) subscription billing for /workspaces (Event Management) access -
# see src/lib/berlanggan/. Optional in stages:
#   - Unset entirely: /pricing shows "coming soon" and /workspaces gating is INERT (open to
#     everyone) - safe default, does not lock anyone out.
#   - BERLANGGAN_PRODUCT_SLUG only: /pricing goes live (its catalog endpoint needs no auth), but
#     gating still stays inert until the two secrets below are also set.
#   - All three set: /workspaces is gated behind an active Berlanggan license - see
#     src/app/(frontend)/workspaces/workspaceAuth.tsx. Run `npm run licenses:grandfather` for any
#     pre-existing accounts BEFORE setting these in production.
BERLANGGAN_BASE_URL=https://berlanggan.web.id
BERLANGGAN_PRODUCT_SLUG=
BERLANGGAN_ACTIVATION_SECRET=
BERLANGGAN_FINGERPRINT_PEPPER=
