FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
COPY patches ./patches
RUN npm ci --legacy-peer-deps
# npm (issue npm/cli#4828) skips platform-specific optionalDependencies when the
# lockfile was generated on a different OS/libc, so on this alpine/musl image the
# native bindings for lightningcss and @tailwindcss/oxide are missing and the
# build dies with "Cannot find module '../lightningcss.linux-x64-musl.node'".
# Install the musl builds explicitly, pinned to the resolved lockfile versions.
RUN npm install --no-save --legacy-peer-deps \
      lightningcss-linux-x64-musl@1.32.0 \
      "@tailwindcss/oxide-linux-x64-musl@4.3.2"

COPY . .

ARG PAYLOAD_SECRET
ARG DATABASE_URL
ENV NODE_ENV=production
ENV PAYLOAD_SECRET=${PAYLOAD_SECRET}
ENV DATABASE_URL=${DATABASE_URL}

RUN mkdir -p src/generated && npm run generate:types
# Turbopack (the Next 16 build default) fails to statically resolve lightningcss's native binding
# on alpine/musl ("Cannot find module '../lightningcss.linux-x64-musl.node'"); the webpack builder
# handles the same tree fine. See CLAUDE memory / redeploy notes.
RUN npm run build -- --webpack

EXPOSE 3000

CMD ["npm", "run", "start"]
